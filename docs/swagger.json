{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/clients": {
            "get": {
                "description": "获取所有当前在线的客户端列表",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "clients"
                ],
                "summary": "获取在线客户端列表",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/clients/{id}": {
            "get": {
                "description": "根据客户端ID获取详细信息",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "clients"
                ],
                "summary": "获取客户端详情",
                "parameters": [
                    {
                        "type": "string",
                        "description": "客户端ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.Client"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/exec": {
            "post": {
                "description": "向指定客户端下发待执行的命令",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "exec"
                ],
                "summary": "向指定客户端下发命令",
                "parameters": [
                    {
                        "description": "执行请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.ExecRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/tasks": {
            "get": {
                "description": "获取所有任务列表",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "获取任务列表",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/tasks/{id}": {
            "get": {
                "description": "根据任务ID获取任务详细信息",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "获取任务详情",
                "parameters": [
                    {
                        "type": "string",
                        "description": "任务ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.Task"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "服务健康状态检查",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "server.Client": {
            "type": "object",
            "properties": {
                "client_id": {
                    "type": "string"
                },
                "hostname": {
                    "type": "string"
                },
                "last_ping": {
                    "type": "string"
                },
                "os": {
                    "type": "string"
                },
                "reg_time": {
                    "type": "string"
                },
                "status": {
                    "description": "online/offline",
                    "type": "string"
                }
            }
        },
        "server.ExecRequest": {
            "type": "object",
            "properties": {
                "client_id": {
                    "type": "string"
                },
                "command": {
                    "type": "string"
                },
                "timeout": {
                    "type": "integer"
                }
            }
        },
        "server.Task": {
            "type": "object",
            "properties": {
                "client_id": {
                    "type": "string"
                },
                "command": {
                    "type": "string"
                },
                "create_at": {
                    "type": "string"
                },
                "end_at": {
                    "type": "string"
                },
                "result": {
                    "$ref": "#/definitions/server.TaskResult"
                },
                "start_at": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "task_id": {
                    "type": "string"
                },
                "timeout": {
                    "description": "timeout in seconds",
                    "type": "integer"
                }
            }
        },
        "server.TaskResult": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "exit_code": {
                    "type": "integer"
                },
                "stderr": {
                    "type": "string"
                },
                "stdout": {
                    "type": "string"
                }
            }
        }
    }
}