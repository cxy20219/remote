[Unit]
Description=tunnel-rs-server (Rust port of go-remote)
Documentation=https://example.invalid/tunnel-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunnel-rs
Group=tunnel-rs
WorkingDirectory=/var/lib/tunnel-rs
StateDirectory=tunnel-rs
StateDirectoryMode=0700

# Listen on all interfaces, port 8080.
Environment=TUNNEL_RS_ADDR=0.0.0.0:8080
Environment=TUNNEL_RS_DATA_DIR=/var/lib/tunnel-rs
# Tune log level / format without editing the unit file.
Environment=RUST_LOG=info
# Set to "json" to switch to structured (container-aggregator friendly) output.
# Environment=RUST_LOG_FORMAT=json

ExecStart=/usr/local/bin/tunnel-rs-server
ExecReload=/bin/kill -HUP $MAINPID

# Graceful shutdown: send SIGTERM, wait up to 30 s for the
# `with_graceful_shutdown` path to drain the state-store and the
# background sync loop. SIGKILL only if it ignores SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=30s
FinalKillSignal=SIGKILL

# Hardening: drop privileges, restrict file system, isolate network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

# Allow the only outbound port we ever use: HTTPS for OCSP / future
# remote-admin traffic. Inbound is governed by ListenStream= above.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource limits: tunnel data is small but concurrent conns can spike.
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
