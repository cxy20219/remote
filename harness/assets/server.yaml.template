server:
  host: "0.0.0.0"
  port: 8080
  tls:
    enabled: false

auth:
  key: "CHANGE-ME-auth-key"

admin:
  password: "CHANGE-ME-admin-password"

security:
  allowed_origins:
    - "{{PUBLIC_HOST}}"
  login_rate_limit: 5
  max_body_size_mb: 10

heartbeat:
  interval: 30
  timeout: 90

log:
  level: "info"
  max_size_mb: 50
  max_backups: 5

tunnel:
  enabled: true
  public_host: "{{PUBLIC_HOST}}"
  port_range_start: 10000
  port_range_end: 20000
  max_tunnels_per_client: 10

swagger:
  enabled: true
